---
interface Props {
  t: any;
}
const { t } = Astro.props;
const milestones = t.story.milestones;
---

<section class="bg-secondary/30 py-20 lg:py-28" id="story">
  <div class="mx-auto max-w-4xl px-6">
    <h2 class="reveal font-display mb-16 text-center text-3xl font-bold tracking-tight text-foreground md:text-4xl">
      {t.story.heading}
    </h2>

    <div class="relative" id="timeline-container">
      <!-- Vertical line (scroll-driven) -->
      <div class="absolute left-4 top-0 hidden h-full w-0.5 bg-border/30 md:left-1/2 md:-ml-px md:block" aria-hidden="true"></div>
      <div id="timeline-line" class="absolute left-4 top-0 hidden w-0.5 bg-brand-500 md:left-1/2 md:-ml-px md:block transition-[height] duration-100" style="height:0%" aria-hidden="true"></div>

      <div class="space-y-12">
        {milestones.map((m: any, i: number) => (
          <div class:list={[
            'relative flex flex-col md:flex-row md:items-start',
            i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse',
          ]}>
            <!-- Year badge -->
            <div class="reveal z-10 mb-4 flex items-center md:absolute md:left-1/2 md:mb-0 md:-translate-x-1/2">
              <span class="rounded-full bg-brand-500 px-4 py-1.5 text-sm font-bold text-white shadow-md">
                {m.year}
              </span>
            </div>

            <!-- Card -->
            <div class:list={[
              'reveal reveal-delay-1 timeline-card ml-12 rounded-xl border border-border bg-background p-6 shadow-sm md:ml-0 md:w-5/12',
              i % 2 === 0 ? 'md:mr-auto md:pr-12' : 'md:ml-auto md:pl-12',
            ]}>
              <h3 class="text-lg font-semibold text-foreground">{m.title}</h3>
              <p class="mt-1 text-sm text-brand-500">{m.location}</p>
              <p class="mt-3 text-sm leading-relaxed text-foreground-muted">{m.description}</p>

              {m.details && (
                <button
                  type="button"
                  class="timeline-toggle mt-3 flex items-center gap-1 text-sm font-medium text-brand-500 hover:text-brand-600 transition-colors cursor-pointer"
                  aria-expanded="false"
                >
                  <svg class="timeline-chevron h-4 w-4 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                  <span class="timeline-toggle-text">{t.lang === 'ru' ? 'Подробнее' : 'Details'}</span>
                </button>

                <div class="timeline-details mt-4 border-t border-border pt-4 grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out">
                  <div class="overflow-hidden">
                  <p class="text-sm font-medium text-foreground">{m.details.company}</p>
                  <p class="text-xs text-foreground-muted mb-3">{m.details.period}</p>
                  <ul class="space-y-1.5">
                    {m.details.bullets.map((b: string) => (
                      <li class="flex items-start gap-2 text-sm text-foreground-muted">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
                        {b}
                      </li>
                    ))}
                  </ul>
                  </div>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initTimelineToggles() {
    document.querySelectorAll('.timeline-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('.timeline-card');
        if (!card) return;
        const details = card.querySelector('.timeline-details') as HTMLElement | null;
        const chevron = btn.querySelector('.timeline-chevron') as HTMLElement | null;
        if (!details) return;

        const isOpen = details.classList.contains('grid-rows-[1fr]');

        if (isOpen) {
          details.classList.remove('grid-rows-[1fr]', 'opacity-100');
          details.classList.add('grid-rows-[0fr]', 'opacity-0');
        } else {
          details.classList.remove('grid-rows-[0fr]', 'opacity-0');
          details.classList.add('grid-rows-[1fr]', 'opacity-100');
        }

        btn.setAttribute('aria-expanded', String(!isOpen));
        if (chevron) {
          chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        }
      });
    });
  }

  initTimelineToggles();
  document.addEventListener('astro:after-swap', initTimelineToggles);
</script>
