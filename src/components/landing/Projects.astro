---
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="py-20 lg:py-28" id="projects">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display mb-16 text-center text-3xl font-bold tracking-tight text-foreground md:text-4xl">
      {t.projects.heading}
    </h2>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.projects.items.map((project: any) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-xl border border-border bg-background p-6 shadow-sm transition-all hover:shadow-md hover:border-brand-500/50"
        >
          <div class="mb-4 flex items-center justify-between">
            <span class="rounded-full bg-brand-500/10 px-3 py-1 text-xs font-semibold text-brand-500">
              {project.tag}
            </span>
            <Icon name="external-link" size="sm" class="text-foreground-muted transition-colors group-hover:text-brand-500" />
          </div>
          <h3 class="mb-2 text-base font-semibold text-foreground">{project.title}</h3>
          <p class="text-sm leading-relaxed text-foreground-muted">{project.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
