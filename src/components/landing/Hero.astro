---
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  t: any;
  locale?: string;
}
const { t, locale } = Astro.props;
---

<section class="relative overflow-hidden py-16 lg:py-24" id="hero">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2 lg:items-start">
    <!-- Content -->
    <div class="flex flex-col items-start">
      <h1 class="hero-animate hero-animate-delay-1 font-display text-5xl font-bold tracking-tight text-foreground md:text-6xl lg:whitespace-nowrap">
        {t.hero.name}
      </h1>
      <p class="hero-animate hero-animate-delay-2 mt-4 text-xl font-medium text-brand-500">
        {t.hero.subtitle}
      </p>
      <p class="hero-animate hero-animate-delay-3 mt-4 max-w-lg text-lg leading-relaxed text-foreground-muted">
        {t.hero.description}
      </p>
      <div class="hero-animate hero-animate-delay-4 mt-6 flex flex-wrap gap-4">
        <Button
          size="lg"
          href={t.contact.telegramUrl}
          target="_blank"
          rel="noopener"
        >
          <Icon name="send" size="sm" />
          {t.hero.cta}
        </Button>
        <Button
          size="lg"
          variant="outline"
          href={`mailto:${t.contact.email}`}
        >
          <Icon name="mail" size="sm" />
          {t.hero.email}
        </Button>
        {
          locale === 'ru' && (
            <Button size="lg" variant="outline" href="/cv.pdf" download>
              <Icon name="download" size="sm" />
              {t.hero.downloadCv}
            </Button>
          )
        }
      </div>
    </div>

    <!-- Photo -->
    <div class="hero-animate hero-animate-delay-3 relative flex justify-center lg:justify-end">
      <div class="relative h-72 w-72 overflow-hidden rounded-2xl shadow-xl md:h-80 md:w-80 lg:h-96 lg:w-96">
        <img
          src="/img/photo.png"
          alt={t.hero.name}
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
