---
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  t: any;
}
const { t } = Astro.props;
---

<section class="py-20 lg:py-28" id="skills">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display mb-4 text-center text-3xl font-bold tracking-tight text-foreground md:text-4xl">
      {t.skills.heading}
    </h2>
    <p class="mx-auto mb-16 max-w-2xl text-center text-lg text-foreground-muted">
      {t.skills.lead}
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.skills.items.map((item: any) => (
        <div class="group rounded-xl border border-border bg-background p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-brand-500/10 text-brand-500">
            <Icon name={item.icon} size="md" />
          </div>
          <h3 class="mb-2 text-base font-semibold text-foreground">{item.title}</h3>
          <p class="text-sm leading-relaxed text-foreground-muted">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
